<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView style="@style/SectionLabel" android:text="PRESETS" />
        <GridLayout
            android:id="@+id/gridPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="20dp"
            android:text="BUILD YOUR OWN (tap to append)" />
        <GridLayout
            android:id="@+id/gridComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sequence" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView
                android:id="@+id/tvSequence"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="(empty)"
                android:textColor="@color/on_surface" android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Clear sequence" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="12dp"
            android:text="PIN LENGTH" />
        <TextView
            android:id="@+id/tvPinLength"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="4 digits"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="12dp"
            android:text="TIME OFFSET (MINUTES, +/-)" />
        <EditText
            android:id="@+id/etOffset"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="numberSigned"
            android:text="0"
            android:textColor="@color/on_surface"
            android:autofillHints="" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="12dp"
            android:text="ADD-ONS" />
        <GridLayout
            android:id="@+id/gridAddons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PIN RIGHT NOW" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="—"
                android:textColor="@color/accent" android:textSize="34sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Strength: —"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- v4 Options -->
        <CheckBox
            android:id="@+id/cbScramble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Scramble the keypad each time"
            android:textColor="@color/on_surface" />

        <CheckBox
            android:id="@+id/cbBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow fingerprint / face unlock"
            android:textColor="@color/on_surface" />

        <!-- v5: Stealth Mode -->
        <CheckBox
            android:id="@+id/cbStealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stealth Mode — hide app icon"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="When hidden, access via dialer: *#*#1234#*#*"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- v5: Intruder Selfie -->
        <CheckBox
            android:id="@+id/cbIntruderSelfie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Intruder Selfie — capture photo on wrong PIN"
            android:textColor="@color/on_surface" />

        <!-- v5: PIN Recovery -->
        <TextView style="@style/SectionLabel" android:layout_marginTop="16dp"
            android:text="PIN RECOVERY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/tvRecoveryCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowRecovery"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Generate Recovery Code" />
        </LinearLayout>

        <!-- v5: WiFi Trust -->
        <TextView style="@style/SectionLabel" android:layout_marginTop="16dp"
            android:text="TRUSTED WIFI" />
        <CheckBox
            android:id="@+id/cbWiFiTrust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-unlock on trusted WiFi"
            android:textColor="@color/on_surface" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etSsid"
                android:layout_width="0dp"
                android:layout_
